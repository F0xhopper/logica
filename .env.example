# Claude API key. Leave unset (or set LOGICA_MOCK=1) to run the deterministic mock pipeline.
ANTHROPIC_API_KEY=

# Force the mock pipeline even when a key is present (1 = on).
LOGICA_MOCK=

# API server port. The web dev server proxies /api to it.
PORT=8787

# Where the file-backed map store writes JSON documents.
LOGICA_DATA_DIR=./.data
